{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "crewMember": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" } }
    },

    "validLicenseCrewList": {
      "type": "object",
      "required": ["crews"],
      "properties": { "crews": { "type": "array", "items": { "$ref": "#/$defs/crewMember" } } }
    }
  }
}