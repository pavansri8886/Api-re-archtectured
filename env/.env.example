# Copy to env/.env.<ENV> (for example env/.env.uat) and fill in. Never commit the real file.
# Names below must match the "Env" names in projects/<project>/project.config.ts
ODS_CREW_V1_URL=https://your-apim-host/ods/crew/v1
ODS_CREW_V2_URL=https://your-apim-host/ods/crew/v2
APIM_SUBSCRIPTION_KEY_V1=
APIM_SUBSCRIPTION_KEY_V2=

# Optional
# PROXY_URL=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1
# REQUEST_TIMEOUT_MS=30000
# IGNORE_HTTPS_ERRORS=false
